# ---------------------------------------------------------------------------
# Production template for Hostinger shared hosting.
#
# Copy to .env ON THE SERVER (File Manager or SFTP) and fill in the blanks.
# .env is gitignored on the production branch too, so deploys never overwrite it.
# After editing this file on the server, re-run: php artisan config:cache
# ---------------------------------------------------------------------------

APP_NAME="Alkes Balikpapan"
APP_ENV=production
# Generate once on the server: php artisan key:generate
APP_KEY=
# APP_DEBUG=true in production leaks a stack trace containing database credentials.
APP_DEBUG=false
APP_URL=https://alkesbalikpapan.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
# Balikpapan is WITA (UTC+8). Do not change this once inquiries exist.
APP_TIMEZONE=Asia/Makassar

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# daily + 14-day retention keeps a shared-hosting disk quota from filling with logs.
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# hPanel -> Databases -> MySQL Databases
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# The site is HTTPS-only; do not let the session cookie travel over plain HTTP.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# No queue worker runs on shared hosting; keep jobs inline.
QUEUE_CONNECTION=sync

CACHE_STORE=database

# hPanel -> Emails -> Email Accounts, then use the SMTP details shown there.
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=halo@alkesbalikpapan.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="halo@alkesbalikpapan.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Analytics — read by config/analytics.php. Leave empty to render no tracking at all.
GA_MEASUREMENT_ID=
META_PIXEL_ID=

# WhatsApp gateway for inquiry notifications (Fonnte). Leave empty to disable.
WA_GATEWAY_TOKEN=

# Read once by DatabaseSeeder to set the admin password. Change the password from
# the app after first login, then clear this value.
ADMIN_PASSWORD=
